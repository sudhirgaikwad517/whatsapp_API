datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

enum UserRole {
  SUPER_ADMIN
  BUSINESS_OWNER
  MANAGER
  AGENT
}

enum WabaStatus {
  DISCONNECTED
  CONNECTED
  SUSPENDED
  RATE_LIMITED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  ACCEPTED
  SENT
  DELIVERED
  READ
  FAILED
  REPLIED
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  LOCATION
  INTERACTIVE
  TEMPLATE
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  PROCESSING
  PAUSED
  COMPLETED
  FAILED
}

enum BillingMode {
  WALLET
  DIRECT_META
  HYBRID
}

enum PlanTier {
  STARTER
  PRO
  ENTERPRISE
}

enum ReservationStatus {
  HELD
  COMPLETED
  RELEASED
  EXPIRED
}

enum WalletTransactionType {
  RECHARGE
  DEBIT
  REFUND
  MANUAL_CREDIT
  MANUAL_DEBIT
  BONUS
}

enum ConversationCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
  SERVICE
}

enum PaymentOrderStatus {
  CREATED
  PAID
  FAILED
  EXPIRED
}

enum PaymentGateway {
  RAZORPAY
  STRIPE
}

enum ConversationStatus {
  OPEN
  ESCALATED
  RESOLVED
  CLOSED
}

enum InvoiceStatus {
  PAID
  PENDING
  FAILED
  REFUNDED
  CANCELLED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketSenderType {
  USER
  SUPER_ADMIN
}

enum SuperAdminRole {
  SUPER_ADMIN
  FINANCE_ADMIN
  OPERATIONS_ADMIN
  SUPPORT_ADMIN
  SALES_ADMIN
  DEVELOPER
}

model Organization {
  id                String             @id @default(uuid()) @db.Uuid
  name              String             @db.VarChar(255)
  slug              String             @unique @db.VarChar(255)
  logoUrl           String?            @db.VarChar(1000)
  timezone          String             @default("UTC") @db.VarChar(100)
  billingMode       BillingMode        @default(WALLET)
  planTier          PlanTier           @default(PRO)
  planExpiryDate    DateTime?
  aiCreditsBalance  Int                @default(0)
  aiKnowledgeBase   String?            @db.Text
  // Stored encrypted (AES-256-GCM via utils/encryption.ts), same as
  // WhatsappAccount.encryptedAccessToken — @db.Text because ciphertext
  // (iv:authTag:encrypted, hex) is longer than the plaintext key.
  geminiApiKey      String?            @db.Text
  isAiAutoRespondEnabled Boolean       @default(false)
  razorpayKeyId     String?            @db.VarChar(255)
  razorpayKeySecret String?            @db.Text
  // Tenant's own business/tax identity — shown in the "Bill To" section of
  // the invoices this org receives, distinct from the platform's own
  // invoice letterhead (SystemSettings).
  billingAddress    String?            @db.Text
  billingGstin      String?            @db.VarChar(50)
  billingPan        String?            @db.VarChar(20)
  billingEmail      String?            @db.VarChar(255)
  billingPhone      String?            @db.VarChar(50)
  // Approved WhatsApp template (by Template.id) used to notify a human agent
  // via WhatsApp when the AI Copilot hands a conversation off to them.
  escalationTemplateId String?         @db.Uuid
  // If the agent a chat is assigned to doesn't open it within this many
  // minutes, it's auto-reassigned to the org owner. Null = feature off.
  slaReassignMinutes Int?
  isSuspended       Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  users             OrganizationMember[]
  whatsappAccounts  WhatsappAccount[]
  templates         Template[]
  contacts          Contact[]
  tags              Tag[]
  segments          Segment[]
  campaigns         Campaign[]
  conversations     Conversation[]
  messages          Message[]
  wallet            Wallet?
  walletReservations WalletReservation[]
  walletLedgers     WalletLedger[]
  paymentOrders     PaymentOrder[]
  invoices          Invoice[]
  supportTickets    SupportTicket[]
  superAdminAuditLogs SuperAdminAuditLog[]
  autoResponderRules AutoResponderRule[]
  cannedResponses   CannedResponse[]
  flows             Flow[]
  productCatalogs   ProductCatalog[]
  auditLogs         AuditLog[]
  timelines         ContactTimeline[]

  @@index([deletedAt])
}

model User {
  id                String             @id @default(uuid()) @db.Uuid
  email             String             @unique @db.VarChar(255)
  passwordHash      String             @db.VarChar(255)
  fullName          String             @db.VarChar(255)
  phoneNumber       String?            @db.VarChar(50)
  isEmailVerified   Boolean            @default(false)
  emailVerifyToken  String?            @db.VarChar(255)
  resetToken        String?            @db.VarChar(255)
  resetTokenExpiry  DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  memberships       OrganizationMember[]
  refreshTokens     RefreshToken[]
  assignedChats     Conversation[]     @relation("AssignedAgent")
  notes             InternalNote[]

  @@index([email])
  @@index([deletedAt])
}

model OrganizationMember {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  userId          String       @db.Uuid
  role            UserRole     @default(AGENT)
  // Org admin (BUSINESS_OWNER) can suspend a member's access without
  // removing them outright — checked at login and on every tenant request.
  isActive        Boolean      @default(true)
  // Which sidebar pages this member may access, by page key (see
  // Sidebar.tsx / requirePageAccess middleware). Empty = unrestricted
  // (full role-default access) — this keeps every existing member's access
  // unchanged until an admin explicitly opts a member into a restricted set.
  allowedPages    String[]     @default([])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model RefreshToken {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  tokenHash   String   @unique @db.VarChar(255)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  revokedAt   DateTime?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model WhatsappAccount {
  id                   String     @id @default(uuid()) @db.Uuid
  organizationId       String     @db.Uuid
  wabaId               String     @db.VarChar(255)
  phoneNumberId        String     @unique @db.VarChar(255)
  displayPhoneNumber   String     @db.VarChar(50)
  qualityRating        String?    @db.VarChar(50)
  messagingLimitTier   String?    @default("TIER_1K") @db.VarChar(50)
  encryptedAccessToken String     @db.Text
  webhookVerifyToken   String     @db.VarChar(255)
  status               WabaStatus @default(DISCONNECTED)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  deletedAt            DateTime?

  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  templates            Template[]
  conversations        Conversation[]

  @@index([organizationId])
  @@index([phoneNumberId])
  @@index([deletedAt])
}

model Template {
  id                String          @id @default(uuid()) @db.Uuid
  organizationId    String          @db.Uuid
  whatsappAccountId String          @db.Uuid
  metaTemplateId    String          @db.VarChar(255)
  name              String          @db.VarChar(255)
  language          String          @db.VarChar(10)
  category          String          @db.VarChar(100)
  // Intentionally a plain String, not an enum: this mirrors whatever status
  // value Meta's Template Management API returns (APPROVED, PENDING, REJECTED,
  // PAUSED, DISABLED, IN_APPEAL, etc.) — a value space we don't control and
  // that Meta can extend at any time. An enum here would risk sync failures
  // the moment Meta introduces a new status.
  status            String          @db.VarChar(50)
  defaultMediaId    String?         @db.VarChar(255)
  components        Json
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  whatsappAccount   WhatsappAccount @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)
  campaigns         Campaign[]

  @@unique([whatsappAccountId, name, language])
  @@index([organizationId])
}

model Contact {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  phoneNumber    String        @db.VarChar(50)
  firstName      String?       @db.VarChar(100)
  lastName       String?       @db.VarChar(100)
  email          String?       @db.VarChar(255)
  customAttributes Json?       @default("{}")
  isOptedIn      Boolean       @default(true)
  optedInAt      DateTime?     @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tags           ContactTag[]
  conversations  Conversation[]
  campaignLogs   CampaignRecipient[]
  timeline       ContactTimeline[]

  @@unique([organizationId, phoneNumber])
  @@index([organizationId, phoneNumber])
  @@index([deletedAt])
}

model Tag {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String       @db.VarChar(100)
  color          String       @default("#6B7280") @db.VarChar(20)
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts       ContactTag[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model ContactTag {
  contactId String  @db.Uuid
  tagId     String  @db.Uuid

  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
}

model Segment {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String       @db.VarChar(255)
  filterRules    Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Conversation {
  id                 String          @id @default(uuid()) @db.Uuid
  organizationId     String          @db.Uuid
  whatsappAccountId  String          @db.Uuid
  contactId          String          @db.Uuid
  assignedAgentId    String?         @db.Uuid
  // When the current assignedAgentId was set — the SLA reassignment clock
  // starts here. agentOpenedAt records when that agent first viewed the
  // chat afterwards; both reset to a fresh assignedAt/null on reassignment.
  assignedAt         DateTime?
  agentOpenedAt      DateTime?
  unreadCount        Int             @default(0)
  lastMessageSnippet String?         @db.Text
  lastMessageAt      DateTime?       @default(now())
  windowExpiresAt    DateTime?
  status             ConversationStatus @default(OPEN)
  firstResponseTimeMs Int?
  resolvedAt         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  whatsappAccount    WhatsappAccount @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)
  contact            Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedAgent      User?           @relation("AssignedAgent", fields: [assignedAgentId], references: [id])
  messages           Message[]
  internalNotes      InternalNote[]

  @@unique([whatsappAccountId, contactId])
  @@index([organizationId, status])
  @@index([organizationId, assignedAgentId])
}

model Message {
  id                 String           @id @default(uuid()) @db.Uuid
  organizationId     String           @db.Uuid
  conversationId     String           @db.Uuid
  wamid              String?          @unique @db.VarChar(255)
  direction          MessageDirection
  type               MessageType      @default(TEXT)
  content            Json
  status             MessageStatus    @default(ACCEPTED)
  errorCode          String?          @db.VarChar(100)
  errorMessage       String?          @db.Text
  sentAt             DateTime?
  deliveredAt        DateTime?
  readAt             DateTime?
  createdAt          DateTime         @default(now())

  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation       Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([wamid])
  @@index([conversationId, createdAt])
}

model InternalNote {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  authorId       String       @db.Uuid
  content        String       @db.Text
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Flow {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String       @db.VarChar(255)
  triggerKeyword String?      @db.VarChar(100)
  definition     Json
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([triggerKeyword])
}

model Campaign {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  templateId     String          @db.Uuid
  name           String          @db.VarChar(255)
  status         CampaignStatus  @default(DRAFT)
  scheduledAt    DateTime?
  totalTarget    Int             @default(0)
  sentCount      Int             @default(0)
  deliveredCount Int             @default(0)
  readCount      Int             @default(0)
  repliedCount   Int             @default(0)
  failedCount          Int             @default(0)
  isBatchEnabled       Boolean         @default(false)
  batchSize            Int             @default(50)
  batchIntervalMinutes Int             @default(20)
  variableMapping      Json?           @default("{}")
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template       Template        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  recipients     CampaignRecipient[]

  @@index([organizationId])
  @@index([status, scheduledAt])
}

model CampaignRecipient {
  id                  String        @id @default(uuid()) @db.Uuid
  campaignId          String        @db.Uuid
  contactId           String        @db.Uuid
  phoneNumberSnapshot String?       @db.VarChar(50)
  nameSnapshot        String?       @db.VarChar(100)
  wamid               String?       @db.VarChar(255)
  status              MessageStatus @default(ACCEPTED)
  variables           Json?
  errorCode           String?       @db.VarChar(100)
  errorMessage        String?       @db.Text
  sentAt              DateTime?
  deliveredAt         DateTime?
  readAt              DateTime?
  repliedAt           DateTime?
  updatedAt           DateTime      @updatedAt

  campaign            Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact             Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@index([wamid])
  @@index([contactId])
}

model ContactTimeline {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  contactId      String       @db.Uuid
  type           String       @db.VarChar(50)
  title          String       @db.VarChar(255)
  description    String?      @db.Text
  metadata       Json?        @default("{}")
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([organizationId, contactId])
  @@index([contactId, createdAt])
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  actorUserId    String?      @db.Uuid
  action         String       @db.VarChar(100)
  resource       String       @db.VarChar(100)
  details        Json
  ipAddress      String?      @db.VarChar(45)
  createdAt      DateTime     @default(now())

  // Restrict, not Cascade: the audit trail should block a hard org delete
  // rather than silently disappear with it (orgs are soft-deleted via
  // deletedAt in normal operation — nothing in the app ever hard-deletes one).
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
}

model Wallet {
  id                  String             @id @default(uuid()) @db.Uuid
  organizationId      String             @unique @db.Uuid
  availableBalance    Decimal            @default(0.0000) @db.Decimal(14, 4)
  reservedBalance     Decimal            @default(0.0000) @db.Decimal(14, 4)
  currency            String             @default("INR") @db.VarChar(3)
  isFrozen            Boolean            @default(false)
  lowBalanceThreshold Decimal            @default(100.0000) @db.Decimal(14, 4)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reservations        WalletReservation[]
  ledgers             WalletLedger[]
}

model WalletReservation {
  id                 String            @id @default(uuid()) @db.Uuid
  walletId           String            @db.Uuid
  organizationId     String            @db.Uuid
  messageReferenceId String            @unique @db.VarChar(255)
  reservedAmount     Decimal           @db.Decimal(14, 4)
  status             ReservationStatus @default(HELD)
  expiresAt          DateTime
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  wallet             Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
}

model WalletLedger {
  id              String                @id @default(uuid()) @db.Uuid
  walletId        String                @db.Uuid
  organizationId  String                @db.Uuid
  transactionType WalletTransactionType
  amount          Decimal               @db.Decimal(14, 4)
  openingBalance  Decimal               @db.Decimal(14, 4)
  closingBalance  Decimal               @db.Decimal(14, 4)
  referenceId     String?               @db.VarChar(255)
  description     String?               @db.Text
  createdAt       DateTime              @default(now())

  wallet          Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: the financial ledger should block a hard org
  // delete rather than vanish with it (see AuditLog for the same rationale).
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
}

model PricingRule {
  id                   String               @id @default(uuid()) @db.Uuid
  countryCode          String               @db.VarChar(10)
  conversationCategory ConversationCategory
  metaCost             Decimal              @db.Decimal(10, 4)
  platformMarkup       Decimal              @db.Decimal(10, 4)
  totalPrice           Decimal              @db.Decimal(10, 4)
  currency             String               @default("INR") @db.VarChar(3)
  effectiveFrom        DateTime             @default(now())
  createdAt            DateTime             @default(now())

  @@unique([countryCode, conversationCategory])
}

model PaymentOrder {
  id              String             @id @default(uuid()) @db.Uuid
  organizationId  String             @db.Uuid
  contactId       String?            @db.Uuid
  gatewayOrderId  String             @unique @db.VarChar(100)
  gatewayName     PaymentGateway
  amount          Decimal            @db.Decimal(12, 2)
  taxAmount       Decimal            @default(0.00) @db.Decimal(12, 2)
  totalAmount     Decimal            @db.Decimal(12, 2)
  paymentLink     String?            @db.Text
  shortUrl        String?            @db.Text
  status          PaymentOrderStatus @default(CREATED)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
}

model ProductCatalog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  title          String       @db.VarChar(255)
  description    String?      @db.Text
  priceInINR     Decimal      @db.Decimal(10, 2)
  imageUrl       String?      @db.Text
  sku            String?      @db.VarChar(100)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Invoice {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  invoiceNumber   String       @unique @db.VarChar(100)
  // Human-readable line item, e.g. "PRO Plan - Monthly Subscription",
  // "AI Credits Top-up", "Wallet Recharge" — set at invoice creation time so
  // the PDF shows exactly what was purchased instead of guessing from the
  // invoice number prefix.
  description     String?      @db.VarChar(255)
  subtotal        Decimal      @db.Decimal(12, 2)
  taxAmount       Decimal      @db.Decimal(12, 2)
  grandTotal      Decimal      @db.Decimal(12, 2)
  currency        String       @default("INR") @db.VarChar(3)
  paymentId       String       @db.VarChar(255)
  gatewayName     String       @db.VarChar(50)
  status          InvoiceStatus @default(PAID)
  createdAt       DateTime     @default(now())

  // Restrict, not Cascade: invoices are financial/tax records that should
  // block a hard org delete rather than vanish with it.
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
}

model SuperAdminUser {
  id              String         @id @default(uuid()) @db.Uuid
  email           String         @unique @db.VarChar(255)
  passwordHash    String         @db.VarChar(255)
  fullName        String         @db.VarChar(255)
  role            SuperAdminRole @default(SUPER_ADMIN)
  mfaEnabled      Boolean        @default(false)
  isActive        Boolean        @default(true)
  resetToken       String?       @db.VarChar(255)
  resetTokenExpiry DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  assignedTickets SupportTicket[]
  auditLogs       SuperAdminAuditLog[]
}

model SupportTicket {
  id              String          @id @default(uuid()) @db.Uuid
  ticketNumber    String          @unique @db.VarChar(50)
  organizationId  String          @db.Uuid
  assignedAdminId String?         @db.Uuid
  subject         String          @db.VarChar(255)
  priority        TicketPriority       @default(MEDIUM)
  status          SupportTicketStatus  @default(OPEN)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedAdmin   SuperAdminUser? @relation(fields: [assignedAdminId], references: [id])
  messages        TicketMessage[]

  @@index([organizationId, status])
}

model TicketMessage {
  id              String        @id @default(uuid()) @db.Uuid
  ticketId        String        @db.Uuid
  senderType      TicketSenderType
  // Not @db.Uuid: superadmin.service.ts's superAdminReplyTicket() writes the
  // sentinel string 'SYSTEM_SUPER_ADMIN' here (no real SuperAdminUser id is
  // threaded through yet) — a strict uuid column would reject that write.
  senderId        String        @db.VarChar(255)
  message         String        @db.Text
  isInternalNote  Boolean       @default(false)
  createdAt       DateTime      @default(now())

  ticket          SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

// Website visitor leads — captured from the marketing site's "Contact"
// popup or the standalone Contact page, before the visitor has any
// account/organization. Deliberately not tied to Organization/User, since
// most leads never sign up.
model Lead {
  id                    String   @id @default(uuid()) @db.Uuid
  name                  String   @db.VarChar(255)
  email                 String   @db.VarChar(255)
  // Nullable — the popup requires it, but the standalone Contact page's
  // phone field is optional, matching that form's existing (unlabelled-*)
  // required-fields UX.
  phoneNumber           String?  @db.VarChar(50)
  // Whether the visitor says they're currently receiving WhatsApp
  // notifications/messages correctly — null if the toggle wasn't answered.
  isReceivingWhatsapp   Boolean?
  message               String?  @db.Text
  // Which website form this came from — e.g. "popup", "contact_page".
  source                String   @default("popup") @db.VarChar(50)
  createdAt             DateTime @default(now())

  @@index([createdAt])
}

model SuperAdminAuditLog {
  id                   String          @id @default(uuid()) @db.Uuid
  actorAdminId         String?         @db.Uuid
  targetOrganizationId String?         @db.Uuid
  action               String          @db.VarChar(100)
  resource             String          @db.VarChar(100)
  details              Json?
  ipAddress            String?         @db.VarChar(45)
  createdAt            DateTime        @default(now())

  actorAdmin           SuperAdminUser? @relation(fields: [actorAdminId], references: [id])
  targetOrganization   Organization?   @relation(fields: [targetOrganizationId], references: [id])

  @@index([action, createdAt])
}

model AutoResponderRule {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  name            String       @db.VarChar(255)
  keywords        String[]
  matchType       String       @default("CONTAINS") @db.VarChar(50)
  replyMessage    String       @db.Text
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, isActive])
}

model CannedResponse {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  shortcut       String       @db.VarChar(50)
  title          String       @db.VarChar(100)
  message        String       @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, shortcut])
  @@index([organizationId])
}

model SystemSettings {
  id                    String   @id @default(uuid()) @db.Uuid
  invoiceCompanyName    String?  @db.VarChar(255)
  invoiceCin            String?  @db.VarChar(100)
  invoiceAddress        String?  @db.Text
  invoiceEmail          String?  @db.VarChar(255)
  invoiceWebsite        String?  @db.VarChar(255)
  invoicePhone          String?  @db.VarChar(50)
  invoiceGstin          String?  @db.VarChar(50)
  invoicePan            String?  @db.VarChar(20)
  invoicePlaceOfSupply  String?  @db.VarChar(100)
  invoiceStateCode      String?  @db.VarChar(10)
  invoiceLogoUrl        String?  @db.Text
  updatedAt             DateTime @updatedAt
}
