# App Execution Context
NODE_ENV=development
PORT=5050
FRONTEND_URL=http://localhost:5173
# Comma-separated extra CORS origins to allow beyond the built-in wabtic.com/localhost list
ALLOWED_ORIGINS=
# Shared cookie domain for auth cookies across subdomains, e.g. ".wabtic.com" in production.
# Leave blank in local dev (cookies default to host-only).
COOKIE_DOMAIN=

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/prowexa_whatsapp?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=prowexa_whatsapp

# Redis Cache & BullMQ
REDIS_URL="redis://localhost:6379"

# Auth Secrets (JWT) — generate real values with: openssl rand -hex 32
# NEVER reuse the example values below; the app refuses to start if you do.
JWT_SECRET="GENERATE_WITH_openssl_rand_-hex_32__DO_NOT_USE_THIS_VALUE"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="GENERATE_A_DIFFERENT_VALUE_WITH_openssl_rand_-hex_32"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Meta WhatsApp Cloud API Configuration
META_API_VERSION="v20.0"
META_GRAPH_BASE_URL="https://graph.facebook.com"
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your_webhook_verify_token_secret"
META_SYSTEM_USER_TOKEN=

# Encryption Key (32 bytes HEX for AES-256-GCM) — generate with: openssl rand -hex 32
# NEVER reuse the example value below; the app refuses to start if you do.
ENCRYPTION_KEY="GENERATE_WITH_openssl_rand_-hex_32__DO_NOT_USE_THIS_VALUE"

# Media Storage (Local / PostgreSQL)
MEDIA_STORAGE_PATH="./uploads"
MEDIA_MAX_SIZE_BYTES=16777216

# Razorpay Payment Gateway (the only payment gateway this app supports)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret configured on the Razorpay Dashboard webhook for this endpoint's URL
RAZORPAY_WEBHOOK_SECRET=

# Google Gemini (AI features)
GEMINI_API_KEY=

# Outbound Email (verification / password reset) — any standard SMTP provider
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Prowexa <no-reply@wabtic.com>"

# Super Admin provisioning (used only by `npm run seed:superadmin`, never at
# server boot) — see SECURITY_NOTES.md
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
