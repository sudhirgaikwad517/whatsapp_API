# App Execution Context
NODE_ENV=development
PORT=5050
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/prowexa_whatsapp?schema=public"

# Redis Cache & BullMQ
REDIS_URL="redis://localhost:6379"

# Auth Secrets (JWT)
JWT_SECRET="super-secret-jwt-key-change-in-production-32chars"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="super-secret-refresh-key-change-in-production-32chars"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Meta WhatsApp Cloud API Configuration
META_API_VERSION="v20.0"
META_GRAPH_BASE_URL="https://graph.facebook.com"
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your_webhook_verify_token_secret"

# Encryption Key (32 bytes HEX for AES-256-GCM)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Media Storage (Local / PostgreSQL)
MEDIA_STORAGE_PATH="./uploads"
MEDIA_MAX_SIZE_BYTES=16777216
